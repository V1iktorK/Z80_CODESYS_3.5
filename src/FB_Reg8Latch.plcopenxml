            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Reg8Latch&#xA;(* 8-bitnyj registr s vstroennoj zashchelkoj.&#xA;Zapis' proishodit tol'ko pri EN i Clk (pomehoustojchivo k dvuhfaznomu taktu). *)&#xA;VAR_INPUT&#xA;	D : BYTE; (* dannye *)&#xA;	EN : BOOL; (* razreshenie zapisi *)&#xA;	Clk : BOOL; (* takt: zapis' tol'ko na fronte *)&#xA;	CLR : BOOL; (* sBros *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Q : BYTE; (* tekuchee sostoyanie *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
