            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecoderZ80&#xA;(* Dekoder komand Z80: IR -&gt; signaly upravleniya.&#xA;Podderzhany: NOP LD ADD SUB INC DEC AND OR XOR CP JP JPcc CALL RET HALT DJNZ RST. *)&#xA;VAR_INPUT&#xA;	IR : BYTE; (* kod operacii *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Ctl_Is_CALL : BOOL;&#xA;	Ctl_Is_RET : BOOL;&#xA;	Ctl_Is_DJNZ : BOOL;&#xA;	Ctl_Is_HALT : BOOL;&#xA;	Ctl_Is_Jump : BOOL;&#xA;	Ctl_Is_Jr : BOOL;&#xA;	Ctl_Imm_Mode : BOOL;&#xA;	Ctl_Flags_En : BOOL;&#xA;	Ctl_Wr_Enable : BOOL;&#xA;	Ctl_Mem_Rd : BOOL;&#xA;	Ctl_Mem_Wr : BOOL;&#xA;	Ctl_Sel_Dst : BYTE;&#xA;	Ctl_Sel_Src : BYTE;&#xA;	Ctl_ALU_Op : BYTE;&#xA;	Ctl_Cond : BYTE;&#xA;	Ctl_IncDec : BOOL; (* TRUE dlya INC/DEC: operand = 1 *)&#xA;	Ctl_Is_IN : BOOL; (* komanda IN A,(n) *)&#xA;	Ctl_Is_OUT : BOOL; (* komanda OUT (n),A *)&#xA;	Ctl_IO_Rd : BOOL; (* strob chteniya porta *)&#xA;	Ctl_IO_Wr : BOOL; (* strob zapisi porta *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
