          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecoderZ80&#xA;(* Dekoder komand Z80: IR -&gt; signaly upravleniya.&#xA;Podderzhany: NOP LD ADD SUB INC DEC AND OR XOR CP JP JPcc CALL RET HALT DJNZ RST. *)&#xA;VAR_INPUT&#xA;	IR : BYTE; (* kod operacii *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Ctl_Is_CALL : BOOL;&#xA;	Ctl_Is_RET : BOOL;&#xA;	Ctl_Is_DJNZ : BOOL;&#xA;	Ctl_Is_HALT : BOOL;&#xA;	Ctl_Is_Jump : BOOL;&#xA;	Ctl_Is_Jr : BOOL;&#xA;	Ctl_Imm_Mode : BOOL;&#xA;	Ctl_Flags_En : BOOL;&#xA;	Ctl_Wr_Enable : BOOL;&#xA;	Ctl_Mem_Rd : BOOL;&#xA;	Ctl_Mem_Wr : BOOL;&#xA;	Ctl_Sel_Dst : BYTE;&#xA;	Ctl_Sel_Src : BYTE;&#xA;	Ctl_ALU_Op : BYTE;&#xA;	Ctl_Cond : BYTE;&#xA;	Ctl_IncDec : BOOL; (* TRUE dlya INC/DEC: operand = 1 *)&#xA;	Ctl_Is_IN : BOOL; (* komanda IN A,(n) *)&#xA;	Ctl_Is_OUT : BOOL; (* komanda OUT (n),A *)&#xA;	Ctl_IO_Rd : BOOL; (* strob chteniya porta *)&#xA;	Ctl_IO_Wr : BOOL; (* strob zapisi porta *)&#xA;END_VAR&#xA;VAR&#xA;	vLo3 : BYTE; (* bity 0..2 koda komandy (nomer istochnika) *)&#xA;	vHi3 : BYTE; (* bity 3..5 koda komandy (priemnik i kod ALU) *)&#xA;	vHi2 : BYTE; (* bity 6..7 koda komandy (klass komandy) *)&#xA;	vDstProj : BYTE; (* nomer registra-priemnika v numeracii proekta *)&#xA;	vSrcProj : BYTE; (* nomer registra-istochnika v numeracii proekta *)&#xA;	vDstAOnly : BOOL; (* priemnik prinuditel no A (ALU, IN A,(n)) *)&#xA;	vDstSel : BYTE; (* Ctl_Sel_Dst *)&#xA;	vDstMemRaw : BOOL; (* pole priemnika ravno (HL) *)&#xA;	vDstMem : BOOL; (* priemnik -- pamyat (HL), krome gruppy ALU *)&#xA;	vSrcSel : BYTE; (* Ctl_Sel_Src *)&#xA;	vImmLdn : BOOL; (* LD r,n: operand beretsya iz IR *)&#xA;	vIsAluGrp : BOOL; (* gruppa ALU (80h..BFh) *)&#xA;	vIsLdRr : BOOL; (* gruppa LD r,r' (40h..7Fh) *)&#xA;	vIrC7 : BYTE; (* IR AND C7h -- maska klassov LD r,n i INC/DEC r *)&#xA;	vIsLdn : BOOL; (* gruppa LD r,n *)&#xA;	vInc4 : BOOL; (* gruppa x4 (INC r) *)&#xA;	vDec5 : BOOL; (* gruppa x5 (DEC r) *)&#xA;	vIncDec : BOOL; (* INC ili DEC: operand raven 1 *)&#xA;	vIsXor : BOOL; (* kod operacii Z80 5 (XOR) *)&#xA;	vIsOrp : BOOL; (* kod operacii Z80 6 (OR) *)&#xA;	vSw56 : BOOL; (* nuzhno pomenyat kody 5 i 6 mestami *)&#xA;	vSwap : BYTE; (* kod operacii posle obmena *)&#xA;	vOpAlu : BYTE; (* kod operacii dlya gruppy ALU *)&#xA;	vOpDec : BYTE; (* kod operacii dlya INC/DEC (0 ili 2) *)&#xA;	vAluSel : BYTE; (* Ctl_ALU_Op *)&#xA;	vIsCp : BOOL; (* komanda CP: rezul tat v registr ne pishetsya *)&#xA;	vWrL : BOOL; (* zapis razreshena klassom LD *)&#xA;	vWrR : BOOL; (* zapis razreshena ALU ili INC/DEC *)&#xA;	vWrBase : BOOL; (* zapis razreshena komandoj *)&#xA;	vWrBase2 : BOOL; (* to zhe s uchetom IN A,(n) *)&#xA;	vWrOk : BOOL; (* zapis razreshena i priemnik ne (HL) *)&#xA;	vWrEn : BOOL; (* Ctl_Wr_Enable *)&#xA;	vSrcMem : BOOL; (* istochnik (HL) *)&#xA;	vMemRdAuto : BOOL; (* chtenie pamyati po maske *)&#xA;	vMemRd : BOOL; (* Ctl_Mem_Rd *)&#xA;	vMemWrAuto : BOOL; (* zapis v pamyat po maske *)&#xA;	vMemWrAuto2 : BOOL; (* to zhe, krome HALT *)&#xA;	vMemWr : BOOL; (* Ctl_Mem_Wr *)&#xA;	vCmdCD : BOOL; (* komanda CDh *)&#xA;	vCmdC9 : BOOL; (* komanda C9h *)&#xA;	vCmd76 : BOOL; (* komanda 76h *)&#xA;	vCmd10 : BOOL; (* komanda 10h *)&#xA;	vCmdC3 : BOOL; (* komanda C3h *)&#xA;	vCmdCA : BOOL; (* komanda CAh *)&#xA;	vCmdC2 : BOOL; (* komanda C2h *)&#xA;	vCmd7E : BOOL; (* komanda 7Eh *)&#xA;	vCmd77 : BOOL; (* komanda 77h *)&#xA;	vCmd3A : BOOL; (* komanda 3Ah *)&#xA;	vCmd32 : BOOL; (* komanda 32h *)&#xA;	vCmdDB : BOOL; (* komanda DBh *)&#xA;	vCmdD3 : BOOL; (* komanda D3h *)&#xA;	vCmdCond : BOOL; (* perehod uslovnyj (JP Z / JP NZ) *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
