VAR_GLOBAL
    (* ================== DANNYE TESTIROVANIYa CP/M ==================
       Otdel nyy nabor, chtoby testy protsessora i testy CP/M mozhno bylo
       zapuskat nezavisimo. Rezul tat kazhdogo -- BOOL: TRUE = PASS. *)
    Cpm_Test_Run         : BOOL;
    Cpm_Test_Count       : INT;

    (* OPISANIE PROVEROK CP/M: 40 strok. *)
    Cpm_Tests            : ARRAY[1..36] OF ST_TestCase_CPM;

    Cpm_Test_Result      : ARRAY[1..36] OF BOOL;
    Cpm_Test_Total_Pass  : INT;
    Cpm_Test_Fail_Count  : INT;
    Cpm_Test_Failed_List : ARRAY[1..16] OF INT;
    (*  S N I M K I  F A K T A: chto imenno sravnivalos s ozhidaemym. *)
    Cpm_Act_A            : ARRAY[1..36] OF BYTE;
    Cpm_Act_W            : ARRAY[1..36] OF WORD;
    Cpm_Act_MaskA        : ARRAY[1..36] OF BOOL;
    Cpm_Act_MaskP        : ARRAY[1..36] OF BOOL;
    (*  R E Z U L ' T A T Y  Sh A G O V  V V O D A - V Y V O D A.
        Stend CP/M vypolnyaet po odnoj komande na shag i skladyvaet syuda
        znachenie registra A. Sm. kommentarij u shagov 50..52. *)
    Cpm_Io_A             : ARRAY[1..32] OF BYTE;
END_VAR
