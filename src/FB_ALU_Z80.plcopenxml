        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_ALU_Z80&#xA;(* Arifmetiko-logicheskoe ustrojstvo Z80.&#xA;Op: 0 ADD, 1 ADC, 2 SUB, 3 SBC, 4 AND, 5 OR, 6 XOR, 7 CP.&#xA;Vse dokumentirovannye flagi: S Z H P/V N C. *)&#xA;VAR_INPUT&#xA;	A : BYTE; (* akkumulyator *)&#xA;	B : BYTE; (* vtoroj operand *)&#xA;	Op : BYTE; (* kod operacii 0..7 *)&#xA;	Carry_In : BOOL; (* vhod perenosa dlya ADC/SBC *)&#xA;	B_Forced : BYTE; (* gotovyj operand dlya INC/DEC (edinit sa) *)&#xA;	IncDec : BOOL; (* TRUE dlya INC/DEC: operand beretsya iz B_Forced *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Y : BYTE; (* rezul'tat *)&#xA;	Flag_S : BOOL; (* znak *)&#xA;	Flag_Z : BOOL; (* nol' *)&#xA;	Flag_H : BOOL; (* poluperenos *)&#xA;	Flag_PV : BOOL; (* chetnost' / perepolnenie *)&#xA;	Flag_N : BOOL; (* vychitanie *)&#xA;	Flag_C : BOOL; (* perenos / zaym *)&#xA;END_VAR&#xA;VAR&#xA;	Is_Logic : BOOL; (* op &gt;= 4: logika (AND/OR/XOR/CP) *)&#xA;	Is_Sub : BOOL; (* op = 2..3: vychitanie (SUB/SBC) *)&#xA;	Is_Arith : BOOL; (* arifmetika (ADD/ADC/SUB/SBC) *)&#xA;	Add_C : BOOL; (* perenos 16-bitnogo slozheniya *)&#xA;	Sub_C : BOOL; (* zaym 16-bitnogo vychitaniya *)&#xA;	Add_Lo : BYTE; (* mladshij bajt summy *)&#xA;	Sub_Lo : BYTE; (* mladshij bajt raznosti *)&#xA;	Sel_Op0 : BOOL; (* op = 0 *)&#xA;	Sel_Op1 : BOOL; (* op = 1 *)&#xA;	Sel_Op2 : BOOL; (* op = 2 *)&#xA;	Sel_Op3 : BOOL; (* op = 3 *)&#xA;	Sel_Op4 : BOOL; (* op = 4 *)&#xA;	Sel_Op5 : BOOL; (* op = 5 *)&#xA;	Logic_And : BYTE; (* A and B (tip zakreplen yavno) *)&#xA;	Logic_Or : BYTE; (* A or B (tip zakreplen yavno) *)&#xA;	Logic_Xor : BYTE; (* A xor B (tip zakreplen yavno) *)&#xA;	vIsCp : BOOL; (* komanda CP (op = 7) *)&#xA;	vBorrow : BOOL; (* vychitanie ili CP: N = 1, C -- zaym *)&#xA;	vAddCM : BOOL; (* perenos dlya ADD/ADC (u logiki vsegda 0) *)&#xA;	vHBit : BOOL; (* poluperenos arifmetiki *)&#xA;	vIsAnd : BOOL; (* operaciya AND (op = 4): H = 1 *)&#xA;	vPar : BOOL; (* chetnost rezul tata *)&#xA;	vEqAb : BOOL; (* A.7 = B.7 *)&#xA;	vNeAy : BOOL; (* A.7 &lt;&gt; Y.7 *)&#xA;	Ovf_Add : BOOL; (* perepolnenie pri slozhenii (tip zakreplen) *)&#xA;	Ovf_Sub : BOOL; (* perepolnenie pri vychitanii (tip zakreplen) *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
