              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_FlagsRegZ80&#xA;(* Registr flagov F (S Z F5 H F3 PV N C).&#xA;Sbor bajta: SHL + ADD. Zapominanie po frontu En. *)&#xA;VAR_INPUT&#xA;	Flag_S : BOOL; (* znak *)&#xA;	Flag_Z : BOOL; (* nol' *)&#xA;	F5 : BOOL; (* nedokumentirovannyj (hranim) *)&#xA;	Flag_H : BOOL; (* poluperenos *)&#xA;	F3 : BOOL; (* nedokumentirovannyj (hranim) *)&#xA;	Flag_PV : BOOL; (* chetnost' / perepolnenie *)&#xA;	Flag_N : BOOL; (* vychitanie *)&#xA;	Flag_C : BOOL; (* perenos / zaym *)&#xA;	En : BOOL; (* razreshenie zapisi *)&#xA;	Init_En : BOOL; (* rezhim initsializatsii flagov *)&#xA;	Init_Val : BYTE; (* nachal noe znachenie F *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	F : BYTE; (* upakovannyj registr flagov *)&#xA;END_VAR&#xA;VAR&#xA;	vBit_7 : BYTE;&#xA;	vBit_6 : BYTE;&#xA;	vBit_5 : BYTE;&#xA;	vBit_4 : BYTE;&#xA;	vBit_3 : BYTE;&#xA;	vBit_2 : BYTE;&#xA;	vBit_1 : BYTE;&#xA;	vBit_0 : BYTE;&#xA;END_VAR&#xA;</xhtml>
