        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_SP_StackZ80&#xA;(* Ukazatel' steka i operacii PUSH/POP.&#xA;CALL: SP-=2 i zapis'; RET: chtenie i SP+=2. Stek rastet vniz. *)&#xA;VAR_INPUT&#xA;	Push : BOOL; (* CALL *)&#xA;	Pop : BOOL; (* RET *)&#xA;	Val_In : WORD; (* chto kladet PUSH (adres vozvrata) *)&#xA;	Mem_Rd : WORD; (* slovo dlya POP (oba bajta srazu) *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	SP : WORD; (* tekuchee znachenie steka *)&#xA;	Val_Out : WORD; (* chto snyato so steka *)&#xA;	Addr : WORD; (* adres dlya obrashcheniya k pamyati *)&#xA;	D_Out : BYTE; (* bajt dlya zapisi *)&#xA;	Wr : BOOL; (* strob zapisi *)&#xA;	Rd : BOOL; (* strob chteniya *)&#xA;END_VAR&#xA;VAR&#xA;	SP_Dec : WORD; (* SP - 2 (tip zakreplen yavno) *)&#xA;	SP_Inc : WORD; (* SP + 2 (tip zakreplen yavno) *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
