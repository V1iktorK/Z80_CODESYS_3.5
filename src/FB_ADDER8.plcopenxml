              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION FB_ADDER8 : WORD&#xA;(* Polnyj 8-bitnyj summator.&#xA;Sum = A+B (16 bit), Carry8 = perenos iz bita 8, Carry4 = perenos iz bita 4. *)&#xA;VAR_INPUT&#xA;	A : BYTE;&#xA;	B : BYTE;&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Sum : WORD; (* A+B v 16 bitah *)&#xA;	Carry8 : BOOL; (* perenos iz bita 8 *)&#xA;	Carry4 : BOOL; (* perenos iz bita 4 *)&#xA;END_VAR&#xA;</xhtml>
