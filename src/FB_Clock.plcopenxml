        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Clock&#xA;(* Dvuhfaznyj takt. ODIN SKAN = ODNA KOMANDA, no komanda&#xA;vypolnyaetsya v dva polutakta, chtoby razorvat petlyu PC-ALU-PC.&#xA;Vhod Limit pozvolyaet vypolnit neskolko komand za skan. *)&#xA;VAR_INPUT&#xA;	Enable : BOOL; (* razreshenie raboty *)&#xA;	Scan : BOOL; (* novyj skan *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Clk_Decode : BOOL; (* FAZA 1: vyborka i dekodirovanie *)&#xA;	Clk_Exec : BOOL; (* FAZA 2: ALU, zapis', PC, flagi *)&#xA;	Busy : BOOL; (* idet obrabotka *)&#xA;END_VAR&#xA;VAR&#xA;	fbPhase : FB_RS; (* faza takta: perekl. kazhdyj skan *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
