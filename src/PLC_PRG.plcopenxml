        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM PLC_PRG&#xA;(* GLAVNAYa SHEMA emulyatora Z80.&#xA;ODIN SKAN PLC = ODNA KOMANDA (v dva polutakta: decode i exec).&#xA;Poryadok setey sootvetstvuet poryadku ispolneniya. *)&#xA;VAR&#xA;	fbClock : FB_Clock; (* dvuhfaznyj takt *)&#xA;	fbAlways : FB_AlwaysTrue; (* signal novyj skan *)&#xA;	fbPC : FB_PC_Z80; (* schetchik komand *)&#xA;	fbPCLatch : FB_Reg16; (* zashchelka PC *)&#xA;	fbIR : FB_Reg8Latch; (* registr komandy *)&#xA;	fbDec : FB_DecoderZ80; (* dekoder *)&#xA;	fbRF : FB_RegFileZ80; (* registrovaya chast' *)&#xA;	fbRFRd : FB_RegFileZ80; (* chtenie registrov (net zapisi) *)&#xA;	fbMem : FB_Memory64K; (* pamyat' 64 KB *)&#xA;	fbALU : FB_ALU_Z80; (* ALU *)&#xA;	fbFlags : FB_FlagsRegZ80; (* registr flagov *)&#xA;	fbSP : FB_SP_StackZ80; (* stek *)&#xA;	fbCtl : FB_ControlUnit; (* upravlenie potokom *)&#xA;	fbR : FB_Reg8; (* registr R *)&#xA;	vRun : BOOL; (* razreshenie raboty *)&#xA;	vScan : BOOL; (* signal novogo skana *)&#xA;	vAddr : WORD; (* adres operanda *)&#xA;	vImm : BYTE; (* neposredstvennyj operand (n) *)&#xA;	vNnHi : BYTE; (* starshij bajt adresa nn *)&#xA;	vSrc : BYTE; (* operand dlya ALU *)&#xA;	vCond : BOOL; (* uslovie perehoda *)&#xA;	vBZero : BOOL; (* schetchik DJNZ obnulilsya *)&#xA;	vPCLoad : BOOL; (* zagruzit' PC *)&#xA;	vPCNew : WORD; (* novoe znachenie PC *)&#xA;	vIncBy : BYTE; (* dlina komandy *)&#xA;	vInitWr : BYTE; (* znachenie dlya zapisi v registr (dlya oboih ekzemplyarov) *)&#xA;	vWrEn : BOOL; (* razreshenie zapisi (dlya oboih ekzemplyarov) *)&#xA;	vClkWr : BOOL; (* takt zapisi: Clk_Exec ili Init_En *)&#xA;	vY : BYTE; (* rezul'tat ALU *)&#xA;	vF : BYTE; (* registr flagov *)&#xA;	vSpRd : WORD; (* slovo, snyatoe so steka *)&#xA;	vMemDrv : BYTE; (* chto na shinu pri chtenii *)&#xA;	vFetch : BYTE; (* vybrannyj kod komandy *)&#xA;	vIOAddr : BYTE; (* adres porta I/O *)&#xA;	vIOEn : BOOL; (* idet obrashchenie k portu I/O *)&#xA;	vIOData : BYTE; (* dannye s shiny I/O *)&#xA;	vInDi : BYTE; (* diskretnye vhody PLK *)&#xA;	vInAI0 : WORD; (* analogovyy vhod 0 *)&#xA;	vInAI1 : WORD; (* analogovyy vhod 1 *)&#xA;	vOutDO : BYTE; (* diskretnye vyhody PLK *)&#xA;	vOutAO0 : WORD; (* analogovyy vyhod 0 *)&#xA;	vOutAO1 : WORD; (* analogovyy vyhod 1 *)&#xA;	vIsBIOS : BOOL; (* PC ukazyvaet v tablitsu BIOS *)&#xA;	fbIO : FB_IO_Ports; (* 256 I/O-portov *)&#xA;	fbHW : FB_HW_IO_PLC; (* apparatnyy interfeys PLK *)&#xA;	fbBIOS : FB_CPM_BIOS; (* minimalnyy BIOS *)&#xA;	vALU_Y : BYTE; (* vyhod FB_ALU_Z80.Y *)&#xA;	vCtl_Halted : BOOL; (* vyhod FB_ControlUnit.Halted *)&#xA;	vCtl_Inc_By : BYTE; (* vyhod FB_ControlUnit.Inc_By *)&#xA;	vCtl_PC_Load : BOOL; (* vyhod FB_ControlUnit.PC_Load *)&#xA;	vCtl_PC_New : WORD; (* vyhod FB_ControlUnit.PC_New *)&#xA;	vFlags_F : BYTE; (* vyhod FB_FlagsRegZ80.F *)&#xA;	vMem_Bus_Drv : BYTE; (* vyhod FB_Memory64K.Bus_Drv *)&#xA;	vMem_D_Out : BYTE; (* vyhod FB_Memory64K.D_Out *)&#xA;	vMem_Rd_Data : BYTE; (* vyhod FB_Memory64K.Rd_Data *)&#xA;	vMem_SP_Out : WORD; (* vyhod FB_Memory64K.SP_Out *)&#xA;	vPC_PC_Next : WORD; (* vyhod FB_PC_Z80.PC_Next *)&#xA;	vRFRd_Addr_HL : WORD; (* vyhod FB_RegFileZ80.Addr_HL *)&#xA;	vR_Q : BYTE; (* vyhod FB_Reg8.Q *)&#xA;	vSP_SP : WORD; (* vyhod FB_SP_StackZ80.SP *)&#xA;	PLC_DI_0 AT %IX0.0 : BOOL; (* diskretnyy vhod 0 (IN 00h, bit 0) *)&#xA;	PLC_DI_1 AT %IX0.1 : BOOL; (* diskretnyy vhod 1 *)&#xA;	PLC_DI_2 AT %IX0.2 : BOOL; (* diskretnyy vhod 2 *)&#xA;	PLC_DI_3 AT %IX0.3 : BOOL; (* diskretnyy vhod 3 *)&#xA;	PLC_DI_4 AT %IX0.4 : BOOL; (* diskretnyy vhod 4 *)&#xA;	PLC_DI_5 AT %IX0.5 : BOOL; (* diskretnyy vhod 5 *)&#xA;	PLC_DI_6 AT %IX0.6 : BOOL; (* diskretnyy vhod 6 *)&#xA;	PLC_DI_7 AT %IX0.7 : BOOL; (* diskretnyy vhod 7 *)&#xA;	PLC_DO_0 AT %QX0.0 : BOOL; (* diskretnyy vyhod 0 (OUT 01h, bit 0) *)&#xA;	PLC_DO_1 AT %QX0.1 : BOOL; (* diskretnyy vyhod 1 *)&#xA;	PLC_DO_2 AT %QX0.2 : BOOL; (* diskretnyy vyhod 2 *)&#xA;	PLC_DO_3 AT %QX0.3 : BOOL; (* diskretnyy vyhod 3 *)&#xA;	PLC_DO_4 AT %QX0.4 : BOOL; (* diskretnyy vyhod 4 *)&#xA;	PLC_DO_5 AT %QX0.5 : BOOL; (* diskretnyy vyhod 5 *)&#xA;	PLC_DO_6 AT %QX0.6 : BOOL; (* diskretnyy vyhod 6 *)&#xA;	PLC_DO_7 AT %QX0.7 : BOOL; (* diskretnyy vyhod 7 *)&#xA;	PLC_AI_0 AT %IW0 : INT; (* analogovyy vhod 0 (IN 02h/03h) *)&#xA;	PLC_AI_1 AT %IW1 : INT; (* analogovyy vhod 1 (IN 06h/07h) *)&#xA;	PLC_AO_0 AT %QW0 : INT; (* analogovyy vyhod 0 (OUT 04h/05h) *)&#xA;	PLC_AO_1 AT %QW1 : INT; (* analogovyy vyhod 1 (OUT 08h/09h) *)&#xA;	vBiosOut : BYTE; (* simvol konsoli ot BIOS *)&#xA;	vBiosWr : BOOL; (* strob vyvoda BIOS *)&#xA;	vBiosRd : BOOL; (* zapros vvoda BIOS *)&#xA;	vPCNext : WORD; (* PC posle inkrementa *)&#xA;	vCtl_Is_CALL : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_RET : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_DJNZ : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_HALT : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_Jump : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_Jr : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Imm_Mode : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Flags_En : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Wr_Enable : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Mem_Rd : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Mem_Wr : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Sel_Dst : BYTE; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Sel_Src : BYTE; (* signal upravleniya ot dekodera *)&#xA;	vCtl_ALU_Op : BYTE; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Cond : BYTE; (* signal upravleniya ot dekodera *)&#xA;	vCtl_IncDec : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_IN : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_Is_OUT : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_IO_Rd : BOOL; (* signal upravleniya ot dekodera *)&#xA;	vCtl_IO_Wr : BOOL; (* signal upravleniya ot dekodera *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
