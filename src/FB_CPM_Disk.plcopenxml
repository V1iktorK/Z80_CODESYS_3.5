              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_CPM_Disk&#xA;(* Operatsii s RAM-diskom A: poisk v kataloge, chtenie i zapis zapisey.&#xA;Adres dannych: 800h + (blok-1)*200h + zapis*80h. *)&#xA;VAR_INPUT&#xA;	Op : BYTE; (* 0 poisk, 1 chtenie, 2 zapis, 3 udalenie *)&#xA;	Index : INT; (* nomer zapisi kataloga *)&#xA;	Block : INT; (* nomer bloka dannyh *)&#xA;	Rec : INT; (* zapis vnutri bloka *)&#xA;	DMA : WORD; (* adres peredachi *)&#xA;	En : BOOL; (* strob *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Found : BOOL; (* fajl najden *)&#xA;	FreeIdx : INT; (* svobodnaya zapis *)&#xA;	FreeFound : BOOL; (* svobodnaya zapis est *)&#xA;	Done : BOOL; (* operatsiya zavershena *)&#xA;	Err : BYTE; (* kod oshibki *)&#xA;	Out_Mode : BYTE; (* rezhim vyvoda: 0 net, 1 odin simvol, 2 stroka do priznak konca *)&#xA;END_VAR&#xA;</xhtml>
