            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_CPM_BIOS&#xA;(* Minimalnyy BIOS CP/M 2.2: konsol i stroki diska.&#xA;Adresa vektorov -- 0FA20h i dalee po 3 bajta. *)&#xA;VAR_INPUT&#xA;	Addr : WORD; (* adres vhoda *)&#xA;	Con_In : BYTE; (* simvol ot terminala *)&#xA;	Con_Rdy : BOOL; (* est simvol *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Con_Out : BYTE; (* simvol dlya konsoli *)&#xA;	Con_Wr : BOOL; (* strob vyvoda *)&#xA;	Con_Rd : BOOL; (* zapros simvola *)&#xA;	Ret_HL : WORD; (* otvet v HL *)&#xA;	Is_Wboot : BOOL; (* zapros perezagruzki *)&#xA;	Done : BOOL; (* obrabotano *)&#xA;END_VAR&#xA;</xhtml>
