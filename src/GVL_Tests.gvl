VAR_GLOBAL
    (* ================== DANNYE TESTIROVANIYa ==================
       Struktura odnogo testa -- tip ST_TestCase. Rezul'tat -- BOOL:
       TRUE = PASS, FALSE = FAIL. Nikakih isklyuchenij: proverka delaetsya
       blokom EQ vnutri FB_TestCase. *)
    Cpu_Test_Run         : BOOL;
    Cpu_Test_Stage       : INT;
    Cpu_Test_Active      : INT;
    Cpu_Test_Count       : INT;

    (* OPISANIE PROVEROK: odna stroka -- odin test.
       R A Z M E R  O B Ya Z A N  S O V P A D A T'  S  C I K L A M I.
       Ranshe zdes' stoyalo [1..40], a v TEST_Z80 obrabotchik hodil po
       WHILE i <= 75 -- to est' chital elementy ZA GRANITSEJ massiva.
       Emulyator na real nom progone zastrel na Cpu_Test_Active = 44:
       vseh testov 40, a on pytalsya vz yat' sorok chetvertyj. V CODESYS
       vyhod za granitsu massiva ne dayot oshibki kompilyatsii i mozhet
       nichego ne soobshchit' vo vremya raboty -- poetomu eto stoyalo
       nezamechennym. Teper' granitsy sovpadayut: 1..75 i <= 75. *)
    Cpu_Tests            : ARRAY[1..75] OF ST_TestCase;

    Cpu_Test_Result      : ARRAY[1..75] OF BOOL;
    Cpu_Test_Executed    : ARRAY[1..75] OF BOOL;
    Cpu_Test_Total_Pass  : INT;
    Cpu_Test_Fail_Count  : INT;
    Cpu_Test_Failed_List : ARRAY[1..16] OF INT;

    (* O T L A D O Ch N Y E  S N I M K I (dlya razbora prohoda).
       Nuzhny, potomu chto chtenie po onlajnu idet medlennee odnogo
       skana PLK, i perehody shagov ne uspet videt. Zdes TEST_Z80
       sam zapisyvaet klyuchevye tochki, i ih mozhno prochitat
       posle prohoda. *)
    Cpu_Act_A        : ARRAY[1..75] OF BYTE;   (* fakt posle komandy *)
    Cpu_Act_F        : ARRAY[1..75] OF BYTE;
    Cpu_Act_PC       : ARRAY[1..75] OF WORD;
    Cpu_Act_IR       : ARRAY[1..75] OF BYTE;   (* chto lezhalo v IR *)
    Cpu_Act_Op       : ARRAY[1..75] OF BYTE;   (* Ctl_ALU_Op *)
    Cpu_Act_Dst      : ARRAY[1..75] OF BYTE;   (* Ctl_Sel_Dst *)
    Cpu_Act_Src      : ARRAY[1..75] OF BYTE;   (* Ctl_Sel_Src *)
    Cpu_Act_Bus      : ARRAY[1..75] OF BYTE;   (* GVL_Bus.Bus_Data = vY *)
    Cpu_Act_WE       : ARRAY[1..75] OF BOOL;   (* Ctl_Wr_Enable *)
    Cpu_Act_ID       : ARRAY[1..75] OF BOOL;   (* Ctl_IncDec *)
    Cpu_Act_MR       : ARRAY[1..75] OF BOOL;   (* Ctl_Mem_Rd *)
    Cpu_Act_MW       : ARRAY[1..75] OF BOOL;   (* Ctl_Mem_Wr *)
    Cpu_Act_RsPC     : ARRAY[1..75] OF WORD;   (* GVL_Regs.Rs_PC *)
    Cpu_Act_NxPC     : ARRAY[1..75] OF WORD;   (* GVL_Regs.Nx_PC *)
    Cpu_Act_Mem0     : ARRAY[1..75] OF BYTE;   (* soderzhimoe Z80_Mem[0] *)
    Cpu_Act_Mem2     : ARRAY[1..75] OF BYTE;   (* Z80_Mem[2] *)
    Cpu_Act_MemE     : ARRAY[1..75] OF BYTE;   (* Z80_Mem[Exp_Mem_Addr] *)
    Cpu_Act_Rst      : ARRAY[1..75] OF BOOL;   (* GVL_Control.Emu_Reset *)
    Cpu_Act_AA       : ARRAY[1..75] OF BYTE;   (* Dbg_ALU_A *)
    Cpu_Act_DV       : ARRAY[1..75] OF BYTE;   (* Dbg_Dst *)
    Cpu_Act_SR       : ARRAY[1..75] OF BYTE;   (* Dbg_Src *)
    Cpu_Act_FE       : ARRAY[1..75] OF BOOL;   (* Dbg_Flags_En *)
    Cpu_Act_RA       : ARRAY[1..75] OF BYTE;   (* Rs_A *)
    Cpu_Act_RB       : ARRAY[1..75] OF BYTE;   (* Rs_B *)
    Cpu_Act_RH       : ARRAY[1..75] OF BYTE;   (* Rs_H *)
    Cpu_Act_RL       : ARRAY[1..75] OF BYTE;   (* Rs_L *)
    Cpu_Act_I0       : ARRAY[1..75] OF BYTE;   (* Init_Vals[0] *)
    Cpu_Act_I1       : ARRAY[1..75] OF BYTE;   (* Init_Vals[1] *)
    Cpu_Act_SD       : ARRAY[1..75] OF BYTE;   (* Init_Sel_Dst *)
    Cpu_Act_IE       : ARRAY[1..75] OF BOOL;   (* Init_En *)
    Cpu_Act_PA       : ARRAY[1..75] OF BYTE;   (* A srazu posle perebora *)
    Cpu_Act_PB       : ARRAY[1..75] OF BYTE;   (* B srazu posle perebora *)
    Cpu_Act_PH       : ARRAY[1..75] OF BYTE;   (* H srazu posle perebora *)
    Cpu_Act_CK       : ARRAY[1..75] OF BOOL;   (* Clk_Exec *)
    Cpu_Act_RN       : ARRAY[1..75] OF BOOL;   (* Emu_Run *)
    Cpu_Act_HT       : ARRAY[1..75] OF BOOL;   (* Halted *)
    Cpu_Act_WEF      : ARRAY[1..75] OF BOOL;   (* deystvuyushchiy strob zapisi *)
    Cpu_Act_FE2      : ARRAY[1..75] OF BOOL;   (* strob zapisi flagov *)
    Cpu_Act_YY       : ARRAY[1..75] OF BYTE;   (* rezul tat ALU *)
    Cpu_Act_OW       : ARRAY[1..75] OF WORD;   (* operandnnaya para nn *)
    Cpu_Act_PN       : ARRAY[1..75] OF WORD;   (* PC_New *)
    Cpu_Act_PL       : ARRAY[1..75] OF BOOL;   (* PC_Load *)
    Cpu_Act_CD       : ARRAY[1..75] OF BOOL;   (* uslovie perehoda *)
    Cpu_Dbg_Init_A   : BYTE;   (* A srazu posle perebora registrov *)
    Cpu_Dbg_Init_F   : BYTE;   (* F srazu posle perebora *)
    Cpu_Dbg_Init_N   : INT;    (* skolko shagov perebora sdelano *)
    Cpu_Dbg_MaxStage : INT;    (* samyy glubokiy dostignutyj shag *)
END_VAR
