        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_CPM_BDOS&#xA;(* Dispatcher BDOS CP/M 2.2. Funktsiya vybiraetsya cepochkoy SEL po C.&#xA;Podderzhany: konsol (1,2,9,10,11), disk (13,14,15,16),&#xA;fajly (19,20,21,22), sluzhebnye (26,27,32,33,34,35). *)&#xA;VAR_INPUT&#xA;	C_Reg : BYTE; (* nomer funktsii BDOS *)&#xA;	DE_Reg : WORD; (* parametr funktsii *)&#xA;	En : BOOL; (* strob vyzova *)&#xA;	Con_In : BYTE; (* simvol ot terminala *)&#xA;	Con_Rdy : BOOL; (* est simvol *)&#xA;	Con_Lin : BOOL; (* stroka vvedena *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Ret_HL : WORD; (* rezul tat v HL *)&#xA;	Done : BOOL; (* obrabotano *)&#xA;	Con_Out : BYTE; (* simvol dlya konsoli *)&#xA;	Con_Wr : BOOL; (* strob vyvoda *)&#xA;	Err : BYTE; (* kod oshibki *)&#xA;END_VAR&#xA;VAR&#xA;	Out_Mode : BYTE; (* rezhim vyvoda: 0 net, 1 odin simvol, 2 stroka do priznak konca *)&#xA;	vDiskOp13 : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vDiskOp15 : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vDiskOp16 : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vFDelete : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vFRead : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vFWrite : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vFMake : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;	vSetDMA : BOOL; (* priznak funktsii BDOS (otladka) *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
