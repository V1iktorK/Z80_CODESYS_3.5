              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_FTrig&#xA;(* Detektor zadnego fronta.&#xA;Q := NOT CLK AND M, gde M -- predydushchij CLK. *)&#xA;VAR_INPUT&#xA;	CLK : BOOL; (* vhodnoj signal *)&#xA;	CLR : BOOL; (* sBros pamyati *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Q : BOOL; (* impul's odin skan pri 1-&gt;0 *)&#xA;	M : BOOL; (* predydushchee znachenie CLK *)&#xA;END_VAR&#xA;</xhtml>
