        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_RegFileZ80&#xA;(* Registrovaya chast' Z80: 16 registrov (osnovnoj i alternativnyj nabory).&#xA;Zapis' po Sel_Dst, chtenie po Sel_Src cherez cepochku SEL. *)&#xA;VAR_INPUT&#xA;	A_In : BYTE; (* tekushchee znachenie A *)&#xA;	B_In : BYTE; (* tekushchee znachenie B *)&#xA;	C_In : BYTE; (* tekushchee znachenie C *)&#xA;	D_In : BYTE; (* tekushchee znachenie D *)&#xA;	E_In : BYTE; (* tekushchee znachenie E *)&#xA;	H_In : BYTE; (* tekushchee znachenie H *)&#xA;	L_In : BYTE; (* tekushchee znachenie L *)&#xA;	F_In : BYTE; (* tekushchee znachenie F *)&#xA;	Sa_In : BYTE; (* tekushchee znachenie Sa *)&#xA;	Sb_In : BYTE; (* tekushchee znachenie Sb *)&#xA;	Sc_In : BYTE; (* tekushchee znachenie Sc *)&#xA;	Sd_In : BYTE; (* tekushchee znachenie Sd *)&#xA;	Se_In : BYTE; (* tekushchee znachenie Se *)&#xA;	Sh_In : BYTE; (* tekushchee znachenie Sh *)&#xA;	Sl_In : BYTE; (* tekushchee znachenie Sl *)&#xA;	Sf_In : BYTE; (* tekushchee znachenie Sf *)&#xA;	Sel_Dst : BYTE; (* nomer registra-priemnika 0..15 *)&#xA;	Sel_Src : BYTE; (* nomer registra-istochnika 0..11 *)&#xA;	Wr_Val : BYTE; (* znachenie dlya zapisi *)&#xA;	Wr_En : BOOL; (* razreshenie zapisi *)&#xA;	Clk : BOOL; (* takt zashchelki *)&#xA;	CLR : BOOL; (* sBros vseh registrov *)&#xA;	Mem_Rd : BYTE; (* znachenie (HL) s shiny *)&#xA;	Imm : BYTE; (* neposredstvennyj operand *)&#xA;	Init_En : BOOL; (* rezhim initsializatsii registrov *)&#xA;	Init_Sel_Dst : BYTE; (* nomer registra pri initsializatsii *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Src_Val : BYTE; (* vybrannoe znachenie *)&#xA;	A : BYTE; (* registr *)&#xA;	B : BYTE; (* registr *)&#xA;	C : BYTE; (* registr *)&#xA;	D : BYTE; (* registr *)&#xA;	E : BYTE; (* registr *)&#xA;	H : BYTE; (* registr *)&#xA;	L : BYTE; (* registr *)&#xA;	F : BYTE; (* registr *)&#xA;	Sa : BYTE; (* registr *)&#xA;	Sb : BYTE; (* registr *)&#xA;	Sc : BYTE; (* registr *)&#xA;	Sd : BYTE; (* registr *)&#xA;	Se : BYTE; (* registr *)&#xA;	Sh : BYTE; (* registr *)&#xA;	Sl : BYTE; (* registr *)&#xA;	Sf : BYTE; (* registr *)&#xA;	Addr_HL : WORD; (* adres pary HL (dlya kosvennoj adresatsii) *)&#xA;END_VAR&#xA;VAR&#xA;	WE_0 : BOOL; (* razreshenie zapisi registra 0 *)&#xA;	WE_1 : BOOL; (* razreshenie zapisi registra 1 *)&#xA;	WE_2 : BOOL; (* razreshenie zapisi registra 2 *)&#xA;	WE_3 : BOOL; (* razreshenie zapisi registra 3 *)&#xA;	WE_4 : BOOL; (* razreshenie zapisi registra 4 *)&#xA;	WE_5 : BOOL; (* razreshenie zapisi registra 5 *)&#xA;	WE_6 : BOOL; (* razreshenie zapisi registra 6 *)&#xA;	WE_7 : BOOL; (* razreshenie zapisi registra 7 *)&#xA;	WE_8 : BOOL; (* razreshenie zapisi registra 8 *)&#xA;	WE_9 : BOOL; (* razreshenie zapisi registra 9 *)&#xA;	WE_10 : BOOL; (* razreshenie zapisi registra 10 *)&#xA;	WE_11 : BOOL; (* razreshenie zapisi registra 11 *)&#xA;	WE_12 : BOOL; (* razreshenie zapisi registra 12 *)&#xA;	WE_13 : BOOL; (* razreshenie zapisi registra 13 *)&#xA;	WE_14 : BOOL; (* razreshenie zapisi registra 14 *)&#xA;	WE_15 : BOOL; (* razreshenie zapisi registra 15 *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
