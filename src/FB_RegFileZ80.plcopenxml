              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_RegFileZ80&#xA;(* Registrovaya chast' Z80: 16 registrov (osnovnoj i alternativnyj nabory).&#xA;Zapis' po Sel_Dst, chtenie po Sel_Src cherez cepochku SEL. *)&#xA;VAR_INPUT&#xA;	A_In : BYTE; (* tekushchee znachenie A *)&#xA;	B_In : BYTE; (* tekushchee znachenie B *)&#xA;	C_In : BYTE; (* tekushchee znachenie C *)&#xA;	D_In : BYTE; (* tekushchee znachenie D *)&#xA;	E_In : BYTE; (* tekushchee znachenie E *)&#xA;	H_In : BYTE; (* tekushchee znachenie H *)&#xA;	L_In : BYTE; (* tekushchee znachenie L *)&#xA;	F_In : BYTE; (* tekushchee znachenie F *)&#xA;	Sa_In : BYTE; (* tekushchee znachenie Sa *)&#xA;	Sb_In : BYTE; (* tekushchee znachenie Sb *)&#xA;	Sc_In : BYTE; (* tekushchee znachenie Sc *)&#xA;	Sd_In : BYTE; (* tekushchee znachenie Sd *)&#xA;	Se_In : BYTE; (* tekushchee znachenie Se *)&#xA;	Sh_In : BYTE; (* tekushchee znachenie Sh *)&#xA;	Sl_In : BYTE; (* tekushchee znachenie Sl *)&#xA;	Sf_In : BYTE; (* tekushchee znachenie Sf *)&#xA;	Sel_Dst : BYTE; (* nomer registra-priemnika 0..15 *)&#xA;	Sel_Src : BYTE; (* nomer registra-istochnika 0..11 *)&#xA;	Wr_Val : BYTE; (* znachenie dlya zapisi *)&#xA;	Wr_En : BOOL; (* razreshenie zapisi *)&#xA;	Clk : BOOL; (* takt zashchelki *)&#xA;	CLR : BOOL; (* sBros vseh registrov *)&#xA;	Mem_Rd : BYTE; (* znachenie (HL) s shiny *)&#xA;	Imm : BYTE; (* neposredstvennyj operand *)&#xA;	Init_En : BOOL; (* rezhim initsializatsii registrov *)&#xA;	Init_Sel_Dst : BYTE; (* nomer registra pri initsializatsii *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Src_Val : BYTE; (* vybrannoe znachenie *)&#xA;	Dst_Val : BYTE; (* znachenie registra-priemnika *)&#xA;	A : BYTE; (* registr *)&#xA;	B : BYTE; (* registr *)&#xA;	C : BYTE; (* registr *)&#xA;	D : BYTE; (* registr *)&#xA;	E : BYTE; (* registr *)&#xA;	H : BYTE; (* registr *)&#xA;	L : BYTE; (* registr *)&#xA;	F : BYTE; (* registr *)&#xA;	Sa : BYTE; (* registr *)&#xA;	Sb : BYTE; (* registr *)&#xA;	Sc : BYTE; (* registr *)&#xA;	Sd : BYTE; (