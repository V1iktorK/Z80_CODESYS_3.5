        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_IO_Ports&#xA;(* 256 I/O-portov Z80. Privyazka portov k apparatnym buferam PLK&#xA;i konsoli CP/M realizovana cepochkoy SEL po adresu porta. *)&#xA;VAR_INPUT&#xA;	Addr : BYTE; (* adres porta *)&#xA;	D_Write : BYTE; (* dannye dlya zapisi *)&#xA;	Rd : BOOL; (* strob chteniya *)&#xA;	Wr : BOOL; (* strob zapisi *)&#xA;	In_DI : BYTE; (* diskretnye vhody PLK *)&#xA;	In_AI0 : WORD; (* analogovyy vhod 0 *)&#xA;	In_AI1 : WORD; (* analogovyy vhod 1 *)&#xA;	Con_In : BYTE; (* simvol ot terminala *)&#xA;	Con_Ready : BOOL; (* est simvol *)&#xA;	Cpm_Ready : BOOL; (* CP/M zagruzhen *)&#xA;END_VAR&#xA;VAR_OUTPUT&#xA;	Rd_Data : BYTE; (* chto vernut na shinu I/O *)&#xA;	Out_DO : BYTE; (* diskretnye vyhody PLK *)&#xA;	Out_AO0 : WORD; (* analogovyy vyhod 0 *)&#xA;	Out_AO1 : WORD; (* analogovyy vyhod 1 *)&#xA;	Con_Out : BYTE; (* simvol dlya konsoli *)&#xA;	Con_Wr : BOOL; (* strob vyvoda *)&#xA;	Con_Port : BYTE; (* nomer konsolnogo porta *)&#xA;	Halt_Req : BOOL; (* zapros ostanovki *)&#xA;END_VAR&#xA;VAR&#xA;	fbPortDO : FB_Reg8; (* vyhodnoj port 01h (derzhitel) *)&#xA;	fbAO0Lo : FB_Reg16; (* mladshij bajt analogovogo vyhoda 0 *)&#xA;	fbAO0Hi : FB_Reg16; (* starshij bajt analogovogo vyhoda 0 *)&#xA;	fbAO1Lo : FB_Reg16; (* mladshij bajt analogovogo vyhoda 1 *)&#xA;	fbAO1Hi : FB_Reg16; (* starshij bajt analogovogo vyhoda 1 *)&#xA;END_VAR&#xA;</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
