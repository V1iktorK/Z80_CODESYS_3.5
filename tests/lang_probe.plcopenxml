    <pous>
      <pou name="P1_ORD_A" pouType="program">
        <interface>
          <localVars>
            <variable name="b"><type><BYTE /></type></variable>
            <variable name="s"><type><derived name="STRING(16)" /></type></variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">b := ORD('A');&#xA;</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM P1_ORD_A
(* proverka: est li funkciya ORD *)
VAR
    b : BYTE;
    s : STRING(16);
END_VAR</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
